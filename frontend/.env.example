# Address of the H-Pesa backend (no trailing slash). Set this on Vercel -> Environment Variables.
VITE_API_URL=https://your-hpesa-backend.onrender.com

# Addresses of the other apps (used by the "Other apps" screen). H-Fleet defaults to https://h-fleet.vercel.app.
# H-Homes and H-Mart only appear once you set their addresses.
VITE_HFLEET_URL=https://h-fleet.vercel.app
VITE_HHOMES_URL=
VITE_HMART_URL=
